# Copy to .env and fill in keys you have. Modules activate automatically when a key is present.
# All modules that do not require a key run out of the box.

# HaveIBeenPwned v3 API key (free): https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# EmailRep.io API key (free tier): https://emailrep.io
EMAILREP_API_KEY=

# GitHub personal access token (increases search rate limit)
GITHUB_TOKEN=

# VirusTotal API key (reserved for future modules)
VIRUSTOTAL_API_KEY=

# AlienVault OTX API key (free): https://otx.alienvault.com/api
OTX_API_KEY=

# ipinfo.io access token (free, 50k req/month)
IPINFO_TOKEN=
